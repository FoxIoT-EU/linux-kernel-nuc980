menuconfig ARCH_NUC980
	bool "Nuvoton NUC980 Architecture"

if ARCH_NUC980

config CPU_NUC980
	bool
	depends on ARCH_MULTI_V5
	select CPU_ARM926T
	select CLKDEV_LOOKUP
	select COMMON_CLK
	select GENERIC_CLOCKEVENTS
	select GENERIC_IRQ_CHIP
	select GPIOLIB
	select IRQ_DOMAIN
	select MULTI_IRQ_HANDLER
	select NUC980_TIMER
	select PINCTRL
	select SPARSE_IRQ
	help
	  Support of Nuvoton NUC980 MPU

endif
